	(text "NOTES\n\nSame net label = connected. Power nets use power symbols (+12V, +5V, +3V3, GND). \nAnalog sensors only on ADC1 pins (I032-39). \nIO12 stays free (strapping pin). \nAdd PWR_FLAG on +12V, +5V, +3V3 and GND so the ERC does not complain. \nAll GND symbols are one net: star point at the buck / battery negative."
		(exclude_from_sim no)
		(at 186.182 143.764 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "924fa166-1d87-4e7e-8d00-67cc906d6fee")
	)
	(text "ON-BOARD(PCB) :power conditioning"
		(exclude_from_sim no)
		(at 38.608 84.582 0)
		(effects
			(font
				(size 1.524 1.524)
			)
		)
		(uuid "a12d942d-3367-4437-9ba6-d33192f01630")
	)
	(text "Camera talks to the DevKit over WiFi (no signal wires).\n Needs a stable 5 V: keep C1 close by.\n\n brushed motors ONLY (2 wires). \nIS pins: check voltage, add divider or zener if > 3.3 V. \nRun: bench (props off) -> tub -> pond with tether"
		(exclude_from_sim no)
		(at 93.218 153.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f5ff7412-559d-4c97-922e-469a92692cfd")
	)
